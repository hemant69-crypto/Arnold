{
  "name": "arnold-consulting",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "node scripts/build.mjs",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "node --import tsx --test tests/*.test.ts",
    "qa:browser": "playwright test",
    "format": "prettier --write src cms scripts tests *.ts *.mjs *.json",
    "predev": "node scripts/prepare-csp.mjs",
    "pretypecheck": "node scripts/prepare-csp.mjs",
    "pretest": "node scripts/prepare-csp.mjs"
  },
  "dependencies": {
    "@sanity/webhook": "4.0.4",
    "gsap": "3.15.0",
    "next": "16.4.0",
    "ogl": "1.0.11",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "lighthouse": "13.5.0",
    "prettier": "3.9.9",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1"
  }
}
